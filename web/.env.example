# ==============================================================================
# ChainTrack Web — Environment Configuration Template (.env.example / .env.local)
# ==============================================================================
# Copy this file to .env.local before running the Next.js development server:
#   cp .env.example .env.local
#
# NEVER commit real private keys, secrets, or production passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Blockchain Network (Local Hardhat Node / Sepolia Testnet)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Server-side RPC URL (used by backend API and indexer)
RPC_URL=http://127.0.0.1:8545

# Deployed SupplyChain contract address (optional override; falls back to deployment.json)
NEXT_PUBLIC_CONTRACT_ADDRESS=
CONTRACT_ADDRESS=

# ------------------------------------------------------------------------------
# 2. Web Application & Authentication (SIWE & JWT)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Secret key for signing session JWTs (minimum 32 random characters recommended)
JWT_SECRET=change_this_to_a_secure_random_jwt_secret_min_32_chars

# Directory for local file uploads (product images)
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chaintrack
POSTGRES_PORT=5432

# Connection string used by Prisma ORM and Next.js backend (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chaintrack?schema=public
