# ==============================================================================
# ChainTrack — Production Environment Variables Reference (.env.production)
# ==============================================================================
# Set these variables in your Vercel Project Dashboard and hosted Indexer worker.
# NEVER commit production private keys or database passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Blockchain Network (Ethereum Sepolia Testnet)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Contract address deployed on Sepolia (populated after running deploy:sepolia)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ------------------------------------------------------------------------------
# 2. Web Application & Authentication (Vercel & SIWE)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_BASE_URL=https://your-chaintrack-app.vercel.app

# Cryptographic secret for signing user session JWTs (minimum 32 characters)
JWT_SECRET=production_secure_jwt_secret_min_32_characters_here

# ------------------------------------------------------------------------------
# 3. Hosted Database (Neon / Supabase PostgreSQL with SSL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/chaintrack?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/chaintrack?sslmode=require

# ------------------------------------------------------------------------------
# 4. Standalone Indexer Worker Daemon (Render / Railway / Fly.io)
# ------------------------------------------------------------------------------
# Set for the continuous indexer service only (DO NOT set DEPLOYER_PRIVATE_KEY on Vercel)
CHAIN_ID=11155111
INDEXER_START_BLOCK=0
INDEXER_POLL_INTERVAL_MS=15000
